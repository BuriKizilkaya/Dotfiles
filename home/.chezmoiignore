Readme.md

# Ignore files, which not needed on linux and macos
{{ if ne .chezmoi.os "windows" }}
.config/powershell
.config/windows-terminal
{{ end }}

# Skip the host's 1Password SSH config inside devcontainers
{{ if eq .env "devcontainer" }}
.ssh/config
.config/ghostty
{{ end }}

# On WSL, SSH is routed through the Windows host (ssh.exe alias / gitconfig
# sshCommand), and there is no native Linux 1Password agent socket to point
# to, so skip the Linux .ssh/config entirely.
{{ if (and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | contains "WSL")) }}
.ssh/config
{{ end }}

# Ignore files, which not needed on windows
{{ if eq .chezmoi.os "windows" }}
.bashrc
.zshrc
.profile.dev
.chezmoi.toml
.ssh/config
**/*.sh
{{ end }}
